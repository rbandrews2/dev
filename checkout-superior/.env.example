# Copy this file to .env and fill in live or test values before deployment.

NODE_ENV=development
PORT=4242
APP_ORIGIN=http://localhost:5174

# Prefer a Stripe restricted API key (rk_) scoped to PaymentIntents, Customers,
# Webhooks read, and any objects your final deployment needs.
STRIPE_RESTRICTED_KEY=rk_live_replace_me

STRIPE_PUBLISHABLE_KEY=pk_live_replace_me

STRIPE_WEBHOOK_SECRET=whsec_replace_me

# Production database. Recommended: managed Postgres on Supabase or Neon in the
# same region as the app host, with SSL required, backups enabled, and direct
# public access restricted to the app runtime where the provider supports it.
DATABASE_URL=postgresql://checkout_app:replace_me@db.example.com:5432/checkout_superior
DATABASE_SSL=true
DATABASE_SSL_REJECT_UNAUTHORIZED=true

# Hosted checkout domain.
PUBLIC_CHECKOUT_URL=https://checkout.superiorllc.org

# Business/legal URLs. Replace typo placeholders before launch.
PRIVACY_POLICY_URL=https://superiorllc.org/privacy-policy
TERMS_URL=https://superiorllc.org/terms
REFUND_POLICY_URL=

# Fee controls. Keep zero unless your legal/payment counsel confirms the fee is permitted.
SERVICE_FEE_CENTS=0
SERVICE_FEE_LABEL=Processing fee

# Recurring billing. Use STRIPE_SUBSCRIPTION_PRICE_ID when you have a Stripe
# Price configured. Otherwise the server can create an inline recurring price
# from SUBSCRIPTION_AMOUNT_CENTS and interval for each new subscription.
SUBSCRIPTIONS_ENABLED=true
# Keep true when purchases may later become subscriptions. Stripe requires a
# Customer plus setup_future_usage=off_session to save the payment method for
# future automatic charges.
SAVE_PAYMENT_METHODS_FOR_FUTURE_CHARGES=true
SUBSCRIPTION_LABEL=Monthly consultation plan
SUBSCRIPTION_AMOUNT_CENTS=25000
SUBSCRIPTION_INTERVAL=month
SUBSCRIPTION_INTERVAL_COUNT=1
STRIPE_SUBSCRIPTION_PRICE_ID=

# Required for POST /api/admin/subscriptions/from-purchase.
SUBSCRIPTION_ADMIN_TOKEN=replace_with_a_long_random_value

# Production should use a real database. This JSON store is for local/dev fallback.
AUTHORIZATION_STORE_PATH=./data/authorizations.json
SUBSCRIPTION_STORE_PATH=./data/subscriptions.json
