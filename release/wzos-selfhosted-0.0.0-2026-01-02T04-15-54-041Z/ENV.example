# Work Zone OS - Environment Variables (copy to .env or provider dashboard)

# Supabase (required)
VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=

# Security (set in secret manager; do NOT commit real values)
VITE_WZOS_SIGNING_SECRET=
VITE_WZOS_VAULT_SECRET=

# Activation (public key only; set via build/CI env, not committed)
VITE_ACTIVATION_PUBLIC_KEY=
# Dev-only bypass for local work (never set in production)
# VITE_LICENSE_OPTIONAL=true

# MOTIV / Dispatch integration (optional; use server-side proxy for secrets)
# For a pure-frontend build, do NOT store secrets in VITE_ vars.
VITE_MOTIV_API_BASE=https://api.gomotiv.com
# If you build a backend/proxy later, store secrets server-side (NOT in VITE_):
# MOTIV_CLIENT_ID=
# MOTIV_CLIENT_SECRET=

# Feature flags
VITE_FEATURE_DISPATCH=true
VITE_INTEGRATIONS_ENABLED=false
