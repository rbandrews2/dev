# Work Zone OS environment example
# Copy this file to .env for local frontend development.
# Store production and server-side values in your hosting provider or Supabase secrets.
# Do not commit real tokens, API keys, webhook secrets, vault keys, or OAuth secrets.

# Frontend: browser-visible Vite config
# These values are bundled into the client. Use provider-side origin restrictions.
VITE_SUPABASE_URL=
VITE_SUPABASE_PUBLISHABLE_KEYS=
VITE_GOOGLE_MAPS_API_KEY=
VITE_GOOGLE_CLIENT_ID=
VITE_GOOGLE_API_KEY=
VITE_WZOS_PUBLIC_SITE_URL=https://workzoneos.org
VITE_MOTIV_API_BASE=https://api.gomotiv.com
VITE_FEATURE_DISPATCH=true
VITE_INTEGRATIONS_ENABLED=false
VITE_VIDEO_CONFERENCE_ENABLED=true
VITE_VIDEO_CONFERENCE_MEETING_ID=
VITE_VIDEO_CONFERENCE_PASSCODE=
VITE_ZOOM_EMBED_URL=
VITE_APP_VERSION=
VITE_ENABLE_ANALYTICS=false

# Supabase Functions / backend secrets
# Set these with `supabase secrets set ...` or your server secret manager.
SUPABASE_URL=
SUPABASE_PUBLISHABLE_KEYS=
SUPABASE_SECRET_KEYS=
PUBLIC_SITE_URL=https://workzoneos.org
PUBLIC_SITE_ALLOWED_ORIGINS=https://workzoneos.netlify.app
WZOS_APP_URL=https://app.superiorllc.org
WZOS_DOWNLOAD_URL=https://workzoneos.org/install
WZOS_PRODUCT_NAME=Work Zone OS
WZOS_WEBHOOK_SIGNING_SECRET=
WZOS_VAULT_MASTER_KEY=

# Commerce and email
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
STRIPE_PRICE_ID_WZOS_CORE=
RESEND_API_KEY=
EMAIL_FROM=

# Bookkeeping integrations
QUICKBOOKS_CLIENT_ID=
QUICKBOOKS_CLIENT_SECRET=
QUICKBOOKS_WEBHOOK_VERIFIER=
QUICKBOOKS_REDIRECT_URI=

# Timekeeping integrations
QUICKBOOKS_TIME_CLIENT_ID=
QUICKBOOKS_TIME_CLIENT_SECRET=
QUICKBOOKS_TIME_WEBHOOK_VERIFIER=
QUICKBOOKS_TIME_REDIRECT_URI=

# Storage and collaboration integrations
GOOGLE_DRIVE_CLIENT_SECRET=
GOOGLE_DRIVE_REDIRECT_URI=
MICROSOFT_GRAPH_CLIENT_ID=
MICROSOFT_GRAPH_CLIENT_SECRET=
MICROSOFT_TENANT_ID=
MICROSOFT_REDIRECT_URI=

# Optional server-side dispatch proxy config
MOTIV_CLIENT_ID=
MOTIV_CLIENT_SECRET=
