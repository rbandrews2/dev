# Work Zone OS - Environment Variables (copy to .env or provider dashboard)

# Supabase (required)
VITE_SUPABASE_URL=
VITE_SUPABASE_PUBLISHABLE_KEYS=

# Browser-visible integration config
# Keep private signing and vault secrets on the server or in Supabase function secrets.
VITE_GOOGLE_CLIENT_ID=
VITE_GOOGLE_API_KEY=
VITE_WZOS_PUBLIC_SITE_URL=https://workzoneos.org

# MOTIV / Dispatch integration (optional; use server-side proxy for secrets)
# For a pure-frontend build, do NOT store private secrets in VITE_ vars.
VITE_MOTIV_API_BASE=https://api.gomotiv.com
# If you build a backend/proxy later, store secrets server-side (NOT in VITE_):
# MOTIV_CLIENT_ID=
# MOTIV_CLIENT_SECRET=

# Feature flags
VITE_FEATURE_DISPATCH=true
VITE_INTEGRATIONS_ENABLED=false
